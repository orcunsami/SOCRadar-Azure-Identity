{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "SOCRadar Identity Intelligence Integration for Microsoft Sentinel",
        "description": "Pulls leaked employee credentials from SOCRadar Identity Intelligence API and takes automated remediation actions in Microsoft Entra ID. Logs to Microsoft Sentinel custom tables.",
        "version": "1.0.0",
        "author": "SOCRadar",
        "lastUpdateTime": "2026-03-29T00:00:00.000Z"
    },
    "parameters": {
        "WorkspaceName": {
            "type": "string",
            "metadata": {
                "description": "Microsoft Sentinel Log Analytics Workspace Name"
            }
        },
        "WorkspaceLocation": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location/region of the Log Analytics workspace"
            }
        },
        "SocradarIdentityApiKey": {
            "type": "securestring",
            "metadata": {
                "description": "SOCRadar Identity Intelligence API Key (pay-per-use, separate from Platform key)"
            }
        },
        "MonitoredDomains": {
            "type": "string",
            "metadata": {
                "description": "Comma-separated list of domains to monitor (e.g., contoso.com,fabrikam.com)"
            }
        },
        "EntraIdTenantId": {
            "type": "string",
            "metadata": {
                "description": "Microsoft Entra ID Tenant ID"
            }
        },
        "EntraIdClientId": {
            "type": "string",
            "metadata": {
                "description": "App Registration Client ID (must have required Graph API permissions)"
            }
        },
        "EntraIdClientSecret": {
            "type": "securestring",
            "metadata": {
                "description": "App Registration Client Secret"
            }
        },
        "SecurityGroupId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Entra ID Security Group ID for compromised users (required if EnableAddToGroup=true)"
            }
        },
        "EnableRevokeSession": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "Revoke all active sign-in sessions for compromised users"
            }
        },
        "EnableAddToGroup": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Add compromised users to security group (requires SecurityGroupId; skipped while it is empty)"
            }
        },
        "EnablePasswordChange": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Force password change on next sign-in for compromised users"
            }
        },
        "EnableDisableAccount": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Disable compromised user accounts (use with caution)"
            }
        },
        "EnableConfirmRisky": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Confirm compromised users in Identity Protection (requires Entra ID P1/P2 license)"
            }
        },
        "EnableCreateIncident": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Deprecated, use IncidentMode. With IncidentMode None, true means Direct."
            }
        },
        "IncidentMode": {
            "type": "string",
            "defaultValue": "None",
            "allowedValues": [
                "None",
                "AlertBacked",
                "Direct"
            ],
            "metadata": {
                "description": "None (default): no incident. AlertBacked: a scheduled analytics rule raises an alert and an incident that shows in the Microsoft Defender portal. Direct: the function creates the incident through the Microsoft Sentinel API; it shows only in the Azure portal and the API, not in the Defender portal."
            }
        },
        "EnableLogPlaintextPassword": {
            "type": "bool",
            "defaultValue": false,
            "metadata": {
                "description": "Write plaintext passwords to Log Analytics tables. By default only password_present/masked fields are stored."
            }
        },
        "PollingIntervalHours": {
            "type": "int",
            "defaultValue": 6,
            "allowedValues": [1, 2, 3, 4, 6, 8, 12, 24],
            "metadata": {
                "description": "How often to check for new leaked credentials, in hours (must divide 24 evenly)"
            }
        },
        "InitialLookbackMinutes": {
            "type": "int",
            "defaultValue": 600,
            "minValue": 0,
            "maxValue": 43200,
            "metadata": {
                "description": "Minutes of history to fetch on first run (600 = 10 hours)"
            }
        },
        "WorkspaceResourceGroup": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Resource group of the Log Analytics workspace (for cross-RG deployments). Leave empty if same as deployment RG."
            }
        },
        "PackageUri": {
            "type": "string",
            "defaultValue": "https://github.com/orcunsami/SOCRadar-Azure-Identity/releases/download/v1.0.0/FunctionApp.zip",
            "metadata": {
                "description": "URL of the FunctionApp deployment package (zip). The shared build is always v1.0.0: internal iterations are tracked in git, not in the tag customers deploy from, so this URL stays put and the release asset behind it is what moves."
            }
        },
        "_packagePushTimestamp": {
            "type": "string",
            "defaultValue": "[utcNow()]",
            "metadata": {
                "description": "Set automatically. Forces the package push to run again on a redeploy, which would otherwise reset WEBSITE_RUN_FROM_PACKAGE and leave the app empty."
            }
        }
    },
    "variables": {
        "functionAppName": "[concat('socradar-identity-', uniqueString(resourceGroup().id))]",
        "managedIdentityName": "SOCRadar-Identity-MI",
        "hostingPlanName": "SOCRadar-Identity-Plan",
        "storageAccountName": "[take(concat('sridentity', uniqueString(resourceGroup().id)), 24)]",
        "tableName": "IdentityState",
        "appInsightsName": "[concat('socradar-identity-ai-', uniqueString(resourceGroup().id))]",
        "StorageTableDataContributorRoleId": "0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3",
        "WebsiteContributorRoleId": "de139f84-1756-47ae-9be6-808fbbe84772",
        "workspaceResourceId": "[resourceId(subscription().subscriptionId, if(empty(parameters('WorkspaceResourceGroup')), resourceGroup().name, parameters('WorkspaceResourceGroup')), 'Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
        "pollingSchedule": "[concat('0 0 */', string(parameters('PollingIntervalHours')), ' * * *')]",
        "effectiveIncidentMode": "[if(and(equals(parameters('IncidentMode'), 'None'), parameters('EnableCreateIncident')), 'Direct', parameters('IncidentMode'))]",
        "workspaceRg": "[if(empty(parameters('WorkspaceResourceGroup')), resourceGroup().name, parameters('WorkspaceResourceGroup'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-04-01",
            "name": "precheck-workspace-exists",
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "WorkspaceResourceId": {
                        "value": "[resourceId(subscription().subscriptionId, if(empty(parameters('WorkspaceResourceGroup')), resourceGroup().name, parameters('WorkspaceResourceGroup')), 'Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "WorkspaceResourceId": {
                            "type": "string"
                        }
                    },
                    "resources": [],
                    "outputs": {
                        "workspaceId": {
                            "type": "string",
                            "value": "[reference(parameters('WorkspaceResourceId'), '2023-09-01', 'Full').properties.customerId]"
                        }
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-04-01",
            "name": "precheck-sentinel-onboarded",
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "WorkspaceResourceId": {
                        "value": "[resourceId(subscription().subscriptionId, if(empty(parameters('WorkspaceResourceGroup')), resourceGroup().name, parameters('WorkspaceResourceGroup')), 'Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "WorkspaceResourceId": {
                            "type": "string"
                        }
                    },
                    "resources": [],
                    "outputs": {
                        "onboardingStateId": {
                            "type": "string",
                            "value": "[reference(concat(parameters('WorkspaceResourceId'), '/providers/Microsoft.SecurityInsights/onboardingStates/default'), '2023-02-01', 'Full').id]"
                        }
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-04-01",
            "name": "socradar-identity-alert-rules",
            "resourceGroup": "[variables('workspaceRg')]",
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "WorkspaceName": {
                        "value": "[parameters('WorkspaceName')]"
                    },
                    "RuleEnabled": {
                        "value": "[equals(variables('effectiveIncidentMode'), 'AlertBacked')]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "WorkspaceName": {
                            "type": "string"
                        },
                        "RuleEnabled": {
                            "type": "bool"
                        }
                    },
                    "variables": {
                        "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
                        "ruleId": "[guid(variables('workspaceResourceId'), 'socradar-identity-rule-leaked-credential')]",
                        "automationRuleId": "[guid(variables('workspaceResourceId'), 'socradar-identity-automation-label')]"
                    },
                    "resources": [
                        {
                            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
                            "apiVersion": "2024-03-01",
                            "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/', variables('ruleId'))]",
                            "kind": "Scheduled",
                            "properties": {
                                "displayName": "SOCRadar Identity - Leaked credential",
                                "description": "Raises one alert, and one incident, for every leaked credential row that SOCRadar Identity Intelligence wrote to SOCRadar_Identity_CL. The account is the Account entity; the monitored domain, the login URL, the country and the Entra ID lookup result are Custom Details. A row that already has an alert is not alerted again.",
                                "severity": "Medium",
                                "enabled": "[parameters('RuleEnabled')]",
                                "query": "// One alert per leaked credential row. The platform runs a rule about 6 minutes behind the clock, so an\n// alert is invisible to a run that follows too closely: runs are an hour apart (a window of 2 days or\n// more needs a frequency of at least 1 hour, measured) and a row is held back until it is 12 minutes\n// old, which also covers a run that follows a redeploy within minutes. Rows\n// that already have an alert are dropped, so a late run cannot alert twice and an incident closed by an\n// analyst is not followed by a second one. The rule runs over 7 days (queryPeriod applies to SecurityAlert too), so that holds within a 7-day window: a row written again after more than 7 days alerts again. Custom Details is a second, still-encoded JSON string with\n// 1-element arrays (live-measured). isfuzzy keeps the rule alive in a workspace where SecurityAlert or\n// the table does not exist yet (the table is created by the first write), and column_ifexists keeps it\n// alive while a column is missing.\nlet Alerted = union isfuzzy=true (datatable(ExtendedProperties:string)[]), SecurityAlert\n| extend AlertedKey = tostring(parse_json(tostring(parse_json(tostring(ExtendedProperties))['Custom Details'])).DedupKey[0])\n| where isnotempty(AlertedKey)\n| distinct AlertedKey;\nunion isfuzzy=true (datatable(TimeGenerated:datetime)[]), SOCRadar_Identity_CL\n| where TimeGenerated > ago(7d)\n| where TimeGenerated < ago(12m)\n| extend Email = tostring(column_ifexists(\"email_s\", \"\")), RecordId = tostring(column_ifexists(\"record_id_s\", \"\")), LoginUrl = tostring(column_ifexists(\"url_s\", \"\"))\n| where isnotempty(Email)\n| extend DedupKey = strcat_delim(\"|\", \"identity\", RecordId, tolower(Email), LoginUrl)\n| join kind=leftanti Alerted on $left.DedupKey == $right.AlertedKey\n| summarize arg_max(TimeGenerated, *) by DedupKey\n| extend Domain = tostring(column_ifexists(\"monitored_domain_s\", \"\")), Country = tostring(column_ifexists(\"country_s\", \"\")), EntraStatus = tostring(column_ifexists(\"entra_status_s\", \"\")), ActionsTaken = tostring(column_ifexists(\"actions_taken_s\", \"\")), SocradarSeverity = tostring(column_ifexists(\"severity_s\", \"\"))\n// Direct sent severity.capitalize() and the function sets MEDIUM for every matched account. Sentinel has no Critical, so CRITICAL (not produced today) is High; a row with no severity (an account that was not matched) is Medium.\n| extend SentinelSeverity = case(toupper(SocradarSeverity) in (\"CRITICAL\", \"HIGH\"), \"High\", toupper(SocradarSeverity) == \"LOW\", \"Low\", toupper(SocradarSeverity) == \"INFORMATIONAL\", \"Informational\", \"Medium\")\n// Name is set only when the id is an address: an id without an @ has no domain part to split.\n| extend AccountName = iff(Email contains \"@\", tostring(split(Email, \"@\")[0]), Email), AccountUPNSuffix = iff(Email contains \"@\", tostring(split(Email, \"@\")[1]), \"\")\n| extend AccountLabel = Email\n| project TimeGenerated, DedupKey, RecordId, Email, AccountName, AccountUPNSuffix, AccountLabel, Domain, LoginUrl, Country, EntraStatus, ActionsTaken, SocradarSeverity, SentinelSeverity\n| order by TimeGenerated asc\n| take 149",
                                "queryFrequency": "PT1H",
                                "queryPeriod": "P7D",
                                "triggerOperator": "GreaterThan",
                                "triggerThreshold": 0,
                                "suppressionDuration": "PT5M",
                                "suppressionEnabled": false,
                                "tactics": [
                                    "CredentialAccess"
                                ],
                                "techniques": [
                                    "T1552"
                                ],
                                "eventGroupingSettings": {
                                    "aggregationKind": "AlertPerResult"
                                },
                                "alertDetailsOverride": {
                                    "alertDisplayNameFormat": "SOCRadar: Leaked credential detected - {{Domain}}",
                                    "alertDescriptionFormat": "SOCRadar Identity Intelligence found a leaked credential for {{AccountLabel}} on {{Domain}}. Entra ID lookup: {{EntraStatus}}.",
                                    "alertSeverityColumnName": "SentinelSeverity"
                                },
                                "customDetails": {
                                    "DedupKey": "DedupKey",
                                    "RecordId": "RecordId",
                                    "MonitoredDomain": "Domain",
                                    "SocradarSeverity": "SocradarSeverity",
                                    "EntraStatus": "EntraStatus",
                                    "ActionsTaken": "ActionsTaken",
                                    "LoginUrl": "LoginUrl",
                                    "Country": "Country"
                                },
                                "entityMappings": [
                                    {
                                        "entityType": "Account",
                                        "fieldMappings": [
                                            {
                                                "identifier": "Name",
                                                "columnName": "AccountName"
                                            },
                                            {
                                                "identifier": "UPNSuffix",
                                                "columnName": "AccountUPNSuffix"
                                            }
                                        ]
                                    }
                                ],
                                "incidentConfiguration": {
                                    "createIncident": true,
                                    "groupingConfiguration": {
                                        "enabled": false,
                                        "reopenClosedIncident": false,
                                        "lookbackDuration": "PT5H",
                                        "matchingMethod": "AllEntities",
                                        "groupByEntities": [],
                                        "groupByAlertDetails": [],
                                        "groupByCustomDetails": []
                                    }
                                }
                            }
                        },
                        {
                            "type": "Microsoft.OperationalInsights/workspaces/providers/automationRules",
                            "apiVersion": "2024-03-01",
                            "name": "[concat(parameters('WorkspaceName'), '/Microsoft.SecurityInsights/', variables('automationRuleId'))]",
                            "dependsOn": [
                                "[resourceId('Microsoft.OperationalInsights/workspaces/providers/alertRules', parameters('WorkspaceName'), 'Microsoft.SecurityInsights', variables('ruleId'))]"
                            ],
                            "properties": {
                                "displayName": "SOCRadar Identity - label incidents created by the leaked credential rule",
                                "order": 10,
                                "triggeringLogic": {
                                    "isEnabled": "[parameters('RuleEnabled')]",
                                    "triggersOn": "Incidents",
                                    "triggersWhen": "Created",
                                    "conditions": [
                                        {
                                            "conditionType": "Property",
                                            "conditionProperties": {
                                                "propertyName": "IncidentRelatedAnalyticRuleIds",
                                                "operator": "Contains",
                                                "propertyValues": [
                                                    "[resourceId('Microsoft.OperationalInsights/workspaces/providers/alertRules', parameters('WorkspaceName'), 'Microsoft.SecurityInsights', variables('ruleId'))]"
                                                ]
                                            }
                                        }
                                    ]
                                },
                                "actions": [
                                    {
                                        "order": 1,
                                        "actionType": "ModifyProperties",
                                        "actionConfiguration": {
                                            "labels": [
                                                {
                                                    "labelName": "SOCRadar"
                                                },
                                                {
                                                    "labelName": "IDENTITY"
                                                },
                                                {
                                                    "labelName": "LeakedCredential"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2023-05-01",
            "name": "[variables('storageAccountName')]",
            "location": "[resourceGroup().location]",
            "sku": {
                "name": "Standard_LRS"
            },
            "kind": "StorageV2",
            "properties": {
                "supportsHttpsTrafficOnly": true,
                "minimumTlsVersion": "TLS1_2"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ]
        },
        {
            "type": "Microsoft.Storage/storageAccounts/tableServices",
            "apiVersion": "2023-05-01",
            "name": "[concat(variables('storageAccountName'), '/default')]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ]
        },
        {
            "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
            "apiVersion": "2023-05-01",
            "name": "[concat(variables('storageAccountName'), '/default/', variables('tableName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/tableServices', variables('storageAccountName'), 'default')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ]
        },
        {
            "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
            "apiVersion": "2023-01-31",
            "name": "[variables('managedIdentityName')]",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ]
        },
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2023-12-01",
            "name": "[variables('hostingPlanName')]",
            "location": "[resourceGroup().location]",
            "sku": {
                "name": "Y1",
                "tier": "Dynamic"
            },
            "kind": "functionapp",
            "properties": {
                "reserved": true
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ]
        },
        {
            "type": "Microsoft.Insights/components",
            "apiVersion": "2020-02-02",
            "name": "[variables('appInsightsName')]",
            "location": "[resourceGroup().location]",
            "kind": "web",
            "properties": {
                "Application_Type": "web",
                "RetentionInDays": 30
            },
            "dependsOn": [
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ]
        },
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2023-12-01",
            "name": "[variables('functionAppName')]",
            "location": "[resourceGroup().location]",
            "kind": "functionapp,linux",
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]": {}
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]",
                "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts/tableServices/tables', variables('storageAccountName'), 'default', variables('tableName'))]",
                "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ],
            "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
                "httpsOnly": true,
                "siteConfig": {
                    "linuxFxVersion": "Python|3.11",
                    "appSettings": [
                        {
                            "name": "AzureWebJobsStorage",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01').keys[0].value, ';EndpointSuffix=core.windows.net')]"
                        },
                        {
                            "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-05-01').keys[0].value, ';EndpointSuffix=core.windows.net')]"
                        },
                        {
                            "name": "WEBSITE_CONTENTSHARE",
                            "value": "[variables('functionAppName')]"
                        },
                        {
                            "name": "FUNCTIONS_EXTENSION_VERSION",
                            "value": "~4"
                        },
                        {
                            "name": "FUNCTIONS_WORKER_RUNTIME",
                            "value": "python"
                        },
                        {
                            "name": "AzureWebJobsFeatureFlags",
                            "value": "EnableWorkerIndexing"
                        },
                        {
                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                            "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
                        },
                        {
                            "name": "WEBSITE_RUN_FROM_PACKAGE",
                            "value": "1"
                        },
                        {
                            "name": "POLLING_SCHEDULE",
                            "value": "[variables('pollingSchedule')]"
                        },
                        {
                            "name": "SOCRADAR_IDENTITY_API_KEY",
                            "value": "[parameters('SocradarIdentityApiKey')]"
                        },
                        {
                            "name": "MONITORED_DOMAINS",
                            "value": "[parameters('MonitoredDomains')]"
                        },
                        {
                            "name": "ENTRA_TENANT_ID",
                            "value": "[parameters('EntraIdTenantId')]"
                        },
                        {
                            "name": "ENTRA_CLIENT_ID",
                            "value": "[parameters('EntraIdClientId')]"
                        },
                        {
                            "name": "ENTRA_CLIENT_SECRET",
                            "value": "[parameters('EntraIdClientSecret')]"
                        },
                        {
                            "name": "SECURITY_GROUP_ID",
                            "value": "[parameters('SecurityGroupId')]"
                        },
                        {
                            "name": "ENABLE_REVOKE_SESSION",
                            "value": "[string(parameters('EnableRevokeSession'))]"
                        },
                        {
                            "name": "ENABLE_ADD_TO_GROUP",
                            "value": "[string(parameters('EnableAddToGroup'))]"
                        },
                        {
                            "name": "ENABLE_PASSWORD_CHANGE",
                            "value": "[string(parameters('EnablePasswordChange'))]"
                        },
                        {
                            "name": "ENABLE_DISABLE_ACCOUNT",
                            "value": "[string(parameters('EnableDisableAccount'))]"
                        },
                        {
                            "name": "ENABLE_CONFIRM_RISKY",
                            "value": "[string(parameters('EnableConfirmRisky'))]"
                        },
                        {
                            "name": "ENABLE_CREATE_INCIDENT",
                            "value": "[string(equals(variables('effectiveIncidentMode'), 'Direct'))]"
                        },
                        {
                            "name": "ENABLE_LOG_PLAINTEXT_PASSWORD",
                            "value": "[string(parameters('EnableLogPlaintextPassword'))]"
                        },
                        {
                            "name": "INITIAL_LOOKBACK_MINUTES",
                            "value": "[string(parameters('InitialLookbackMinutes'))]"
                        },
                        {
                            "name": "WORKSPACE_ID",
                            "value": "[reference(variables('workspaceResourceId'), '2023-09-01').customerId]"
                        },
                        {
                            "name": "WORKSPACE_KEY",
                            "value": "[listKeys(variables('workspaceResourceId'), '2023-09-01').primarySharedKey]"
                        },
                        {
                            "name": "WORKSPACE_NAME",
                            "value": "[parameters('WorkspaceName')]"
                        },
                        {
                            "name": "WORKSPACE_LOCATION",
                            "value": "[parameters('WorkspaceLocation')]"
                        },
                        {
                            "name": "WORKSPACE_RESOURCE_GROUP",
                            "value": "[if(empty(parameters('WorkspaceResourceGroup')), resourceGroup().name, parameters('WorkspaceResourceGroup'))]"
                        },
                        {
                            "name": "SUBSCRIPTION_ID",
                            "value": "[subscription().subscriptionId]"
                        },
                        {
                            "name": "STORAGE_ACCOUNT_NAME",
                            "value": "[variables('storageAccountName')]"
                        },
                        {
                            "name": "AZURE_CLIENT_ID",
                            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), '2023-01-31').clientId]"
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), variables('managedIdentityName'), variables('StorageTableDataContributorRoleId'))]",
            "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('StorageTableDataContributorRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceId('Microsoft.Web/sites', variables('functionAppName')), variables('managedIdentityName'), variables('WebsiteContributorRoleId'))]",
            "scope": "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]",
                "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('WebsiteContributorRoleId'))]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "type": "Microsoft.Resources/deploymentScripts",
            "apiVersion": "2020-10-01",
            "name": "[concat('triggerFirstRun-', uniqueString(resourceGroup().id))]",
            "location": "[resourceGroup().location]",
            "kind": "AzureCLI",
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('managedIdentityName'))]": {}
                }
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
                "[guid(resourceId('Microsoft.Web/sites', variables('functionAppName')), variables('managedIdentityName'), variables('WebsiteContributorRoleId'))]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-workspace-exists')]",
                "[resourceId('Microsoft.Resources/deployments', 'precheck-sentinel-onboarded')]"
            ],
            "properties": {
                "azCliVersion": "2.50.0",
                "forceUpdateTag": "[parameters('_packagePushTimestamp')]",
                "retentionInterval": "PT26H",
                "timeout": "PT30M",
                "cleanupPreference": "OnSuccess",
                "scriptContent": "set -e; code=$(curl -s -o /dev/null -w '%{http_code}' -L \"$PACKAGE_URL\"); [ \"$code\" = 200 ] || { echo \"package URL returned HTTP $code\" >&2; exit 1; }; curl -sSL -o /tmp/package.zip \"$PACKAGE_URL\"; python3 -c \"import zipfile;zipfile.ZipFile('/tmp/package.zip').testzip()\" >/dev/null 2>&1 || { echo 'downloaded package is not a readable zip' >&2; exit 1; }; echo \"package downloaded: $(stat -c%s /tmp/package.zip) bytes\"; echo 'reading the app storage connection while the role assignment propagates'; CONN=; for wait in $(seq 1 8); do CONN=$(az functionapp config appsettings list --name \"$FA_NAME\" --resource-group \"$RG_NAME\" --query \"[?name=='AzureWebJobsStorage'].value\" -o tsv 2>/dev/null || true); [ -n \"$CONN\" ] && break; echo \"attempt $wait: the app settings are not readable yet\"; sleep 15; done; [ -n \"$CONN\" ] || { echo 'the app settings stayed unreadable for two minutes: the Website Contributor assignment never became effective' >&2; exit 1; }; SA=$(printf '%s' \"$CONN\" | sed -n 's/.*AccountName=\\([^;]*\\).*/\\1/p'); [ -n \"$SA\" ] || { echo 'the app storage connection carries no AccountName' >&2; exit 1; }; echo \"staging the package in the app storage account $SA\"; pointer() { az functionapp config appsettings list --name \"$FA_NAME\" --resource-group \"$RG_NAME\" --query \"[?name=='WEBSITE_RUN_FROM_PACKAGE'].value\" -o tsv 2>/dev/null; }; shape() { case \"$(pointer)\" in *function-releases*) echo blob;; 1) echo one;; '') echo missing;; *) echo other;; esac; }; staged() { [ \"$(shape)\" = blob ]; }; count() { az rest --method get --url \"https://management.azure.com/subscriptions/$SUB_ID/resourceGroups/$RG_NAME/providers/Microsoft.Web/sites/$FA_NAME/functions?api-version=2023-12-01\" --query 'length(value)' -o tsv 2>/dev/null || echo 0; }; indexed() { n=$(count); case \"$n\" in ''|*[!0-9]*) return 1;; esac; [ \"$n\" -ge 1 ]; }; BLOB=package-$(date -u +%Y%m%d%H%M%S).zip; for attempt in $(seq 1 6); do az storage container create --name function-releases --connection-string \"$CONN\" -o none >/dev/null 2>&1 || true; if az storage blob upload --container-name function-releases --name \"$BLOB\" --file /tmp/package.zip --overwrite --connection-string \"$CONN\" -o none >/dev/null 2>&1; then SAS=$(az storage blob generate-sas --container-name function-releases --name \"$BLOB\" --permissions r --expiry 2099-12-31T00:00:00Z --connection-string \"$CONN\" -o tsv 2>/dev/null); { [ -n \"$SAS\" ] && az functionapp config appsettings set --name \"$FA_NAME\" --resource-group \"$RG_NAME\" --settings \"WEBSITE_RUN_FROM_PACKAGE=https://$SA.blob.core.windows.net/function-releases/$BLOB?$SAS\" -o none >/dev/null 2>&1; } || echo \"attempt $attempt: no read token was issued for the staged package\"; else echo \"attempt $attempt: the package upload failed; the readings decide\"; fi; echo \"attempt $attempt: pointer=$(shape) functions=$(count)\"; staged && break; sleep 30; done; staged || { echo 'the package pointer never became a blob under function-releases: the app would have no code to reload' >&2; exit 1; }; echo 'restarting the app so the host reloads the staged package'; az functionapp restart --name \"$FA_NAME\" --resource-group \"$RG_NAME\" -o none >/dev/null 2>&1 || echo 'the restart call did not go through; the readings decide'; for i in $(seq 1 40); do sleep 15; indexed && { echo \"$(count) function(s) indexed after $((i * 15))s; run_on_startup triggers the first import\"; exit 0; }; done; echo 'the package is staged but no function was indexed in 10 minutes' >&2; exit 1",
                "environmentVariables": [
                    {
                        "name": "FA_NAME",
                        "value": "[variables('functionAppName')]"
                    },
                    {
                        "name": "RG_NAME",
                        "value": "[resourceGroup().name]"
                    },
                    {
                        "name": "SUB_ID",
                        "value": "[subscription().subscriptionId]"
                    },
                    {
                        "name": "PACKAGE_URL",
                        "value": "[parameters('PackageUri')]"
                    }
                ]
            }
        }
    ],
    "outputs": {
        "functionAppName": {
            "type": "string",
            "value": "[variables('functionAppName')]"
        },
        "storageAccountName": {
            "type": "string",
            "value": "[variables('storageAccountName')]"
        },
        "pollingSchedule": {
            "type": "string",
            "value": "[variables('pollingSchedule')]"
        }
    }
}
